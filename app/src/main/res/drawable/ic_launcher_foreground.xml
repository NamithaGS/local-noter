<?xml version="1.0" encoding="utf-8"?><!--
  Microphone glyph for the adaptive launcher icon. Drawn inside the inner 72dp safe
  zone of the 108dp canvas so no part is clipped by the system's icon mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Capsule body -->
    <path
        android:fillColor="#F5F7FA"
        android:pathData="M54,32 c-4.42,0 -8,3.58 -8,8 v10 c0,4.42 3.58,8 8,8 s8,-3.58 8,-8 v-10 c0,-4.42 -3.58,-8 -8,-8 z" />

    <!-- Cradle -->
    <path
        android:pathData="M40,48 v3 c0,7.73 6.27,14 14,14 s14,-6.27 14,-14 v-3"
        android:strokeColor="#5FB3A3"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- Stem and base -->
    <path
        android:pathData="M54,65 v8"
        android:strokeColor="#5FB3A3"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M45,74 h18"
        android:strokeColor="#5FB3A3"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
</vector>
